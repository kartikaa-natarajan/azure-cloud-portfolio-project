# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/hemanth-portfolio

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=portfolio_token

# Admin bootstrap (used only by npm run seed)
ADMIN_NAME=Hemanth Raj
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# GitHub
GITHUB_USERNAME=StarlightSerena
GITHUB_TOKEN=

# Email (Nodemailer - e.g. Gmail App Password or any SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=your.email@example.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
